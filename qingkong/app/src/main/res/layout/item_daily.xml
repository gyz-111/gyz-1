<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <TextView
        android:id="@+id/dayLabel"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="今天"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/dayIcon"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="⛅"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/dayCond"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="晴"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/dayLow"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:text="18°"
        android:textColor="@color/temp_low"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/dayBarBox"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/dayBarLeft"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0" />

        <View
            android:id="@+id/dayBar"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_temp_bar" />

        <View
            android:id="@+id/dayBarRight"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0" />
    </LinearLayout>

    <TextView
        android:id="@+id/dayHigh"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:text="28°"
        android:textColor="@color/temp_high"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/dayPrecip"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="right"
        android:text=""
        android:textColor="@color/accent_cyan"
        android:textSize="11sp" />
</LinearLayout>
